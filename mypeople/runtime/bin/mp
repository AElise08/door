#!/usr/bin/env python3
"""mp - mypeople CLI. verbs: status spawn send peek kill answer revive.
Implements the §4 agent_id<->tmux mapping and the §5 spawn contracts."""
import os, sys, json, time, shlex, subprocess, shutil

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import mpcommon as C

CFG = C.CFG
INSTALL_DIR = CFG["INSTALL_DIR"]
HOST_ID = CFG["HOST_ID"]
QUEUE_URL = CFG["QUEUE_URL"]
SECRET = CFG.get("QUEUE_SECRET", "")
TTYD_PORT = CFG["TTYD_PORT"]
DEFAULT_ENG_MODEL = CFG["DEFAULT_ENG_MODEL"]
ROSTER_PATH = os.path.join(INSTALL_DIR, "run", "roster.json")
STATUS_DIR = os.path.join(INSTALL_DIR, "status")
HOOK = os.path.join(INSTALL_DIR, "plugins", "tmux-boss-hooks", "emit-event.sh")
BOSS_DOC = os.path.join(INSTALL_DIR, "boss-CLAUDE.md")
HDR = {"X-Queue-Secret": SECRET}
DOCTRINE_SUMMARY = ("Boss onboarded: plan-gate before engineering, drive the team autonomously "
                    "off the board via the mp queue (fire-and-forget), verify every result.")


def full_aid(aid):
    return aid if "/" in aid else "%s/%s" % (HOST_ID, aid)


def is_local(aid):
    host, _, _ = C.parse_agent_id(aid)
    return not host or host == HOST_ID


def remote_task(typ, aid, payload=None, timeout=150):
    """Submit a cross-host command through the queue and wait for its result."""
    code, out = C.http_json("POST", QUEUE_URL + "/task/submit",
                            {"type": typ, "target_agent": aid, "payload": payload or {}},
                            HDR, timeout=8)
    if code != 200 or not isinstance(out, dict) or not out.get("task_id"):
        return False, "queue submit failed (HTTP %s)" % code
    tid = out["task_id"]
    deadline = time.time() + timeout
    while time.time() < deadline:
        code, state = C.http_json("GET", QUEUE_URL + "/task/" + tid, None, HDR, timeout=8)
        if code == 200 and isinstance(state, dict) and state.get("ok") is not None:
            return bool(state.get("ok")), state.get("result", "")
        time.sleep(0.5)
    return False, "queue task timed out: %s" % tid


def envq(**kw):
    return " ".join("%s=%s" % (k, shlex.quote(str(v))) for k, v in kw.items())


def load_roster():
    return C.read_json(ROSTER_PATH, {}) or {}


def save_roster(r):
    C.write_json(ROSTER_PATH, r)


def pretrust(cwd):
    """Merge projects[cwd].hasTrustDialogAccepted=true into ~/.claude.json (§5.5c)."""
    p = os.path.expanduser("~/.claude.json")
    d = C.read_json(p, {}) or {}
    if not isinstance(d, dict):
        d = {}
    proj = d.setdefault("projects", {})
    for path in {cwd, os.path.abspath(cwd)}:
        rec = proj.get(path, {})
        rec["hasTrustDialogAccepted"] = True
        proj[path] = rec
    C.write_json(p, d)


def write_status(aid, status, summary=None, locked=False):
    _, sess, tab = C.parse_agent_id(aid)
    d = os.path.join(STATUS_DIR, "mc-%s" % sess)
    p = os.path.join(d, "%s.json" % tab)
    cur = C.read_json(p, {}) or {}
    cur.update({"status": status, "timestamp": time.time(),
                "backend": cur.get("backend", "claude"), "state": "alive"})
    if summary is not None:
        cur["summary"] = summary
    if locked:
        cur["summary_locked"] = True
    C.write_json(p, cur)


def window_exists(sess, tab):
    r = subprocess.run(["tmux", "list-windows", "-t", "mc-%s" % sess, "-F", "#{window_name}"],
                       capture_output=True, text=True)
    return r.returncode == 0 and tab in r.stdout.split()


def session_exists(sess):
    return subprocess.run(["tmux", "has-session", "-t", "mc-%s" % sess],
                          capture_output=True).returncode == 0


def tmux_env():
    e = dict(os.environ)
    e.pop("TMUX", None)
    return e


def start_recorder(tab, sess):
    """Auto-start a read-only asciinema recorder on the new pane (§spawn-recording). Best-effort."""
    rec_sess = "rec-%s" % tab
    e = tmux_env()
    if subprocess.run(["tmux", "has-session", "-t", rec_sess], env=e, capture_output=True).returncode == 0:
        return
    cast = os.path.expanduser("~/recordings/%s-%s.cast" % (HOST_ID, tab))
    os.makedirs(os.path.dirname(cast), exist_ok=True)
    if not shutil.which("asciinema"):
        return
    inner = "TMUX= tmux attach -rt mc-%s:%s" % (sess, tab)
    cmd = "asciinema rec --quiet --append -c %s %s" % (shlex.quote(inner), shlex.quote(cast))
    try:
        subprocess.run(["tmux", "new-session", "-d", "-s", rec_sess, cmd], env=e,
                       capture_output=True, timeout=10)
    except Exception:
        pass


def build_launch(aid, cwd, boss_id, is_master, model, resume_session=None):
    exports = {
        "PATH": "%s/.local/bin:%s/bin:%s" % (os.path.expanduser("~"), INSTALL_DIR, os.environ.get("PATH", "/usr/bin")),
        "AGENT_ID": aid,
        "QUEUE_URL": QUEUE_URL,
        "QUEUE_SECRET": SECRET,
        "HOST_ID": HOST_ID,
        "INSTALL_DIR": INSTALL_DIR,
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    }
    prefix = "env"
    if is_master:
        prefix += " -u BOSS_ID"  # top-level agent must not inherit a leaked boss
    else:
        exports["BOSS_ID"] = boss_id
    envstr = envq(**exports)
    claude = "claude --dangerously-skip-permissions"
    if not is_master and model:
        claude += " --model %s" % model
    elif is_master and model:
        claude += " --model %s" % model
    if resume_session:
        claude += " --resume %s" % shlex.quote(resume_session)
    return "%s %s %s" % (prefix, envstr, claude)


def do_spawn(argv, resume_session=None):
    if not argv:
        print("usage: mp spawn <agent_id> [--backend claude] [--cwd PATH] [--boss <id>] [--master] [--model <id>]",
              file=sys.stderr)
        return 2
    aid = full_aid(argv[0])
    backend = "claude"
    cwd = None
    boss = None
    boss_given = False
    is_master = False
    model = None
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--backend":
            i += 1; backend = argv[i]
        elif a == "--cwd":
            i += 1; cwd = argv[i]
        elif a == "--boss":
            boss_given = True
            i += 1; boss = argv[i] if i < len(argv) else ""
        elif a == "--master":
            is_master = True
        elif a == "--model":
            i += 1; model = argv[i]
        i += 1
    # empty --boss is a HARD ERROR (§5 spawn env-export contract)
    if boss_given and (boss is None or boss.strip() == ""):
        print("ERROR: --boss given with an empty/whitespace value (unset $AGENT_ID bug); refusing to "
              "create an agent whose boss resolves to '<host>/'.", file=sys.stderr)
        return 3
    boss_id = full_aid(boss) if (boss_given and boss.strip()) else ""
    if not is_master and model is None:
        model = DEFAULT_ENG_MODEL   # explicit model pinning for engineers (§5)
    if not is_local(aid):
        ok, result = remote_task("spawn", aid, {
            "backend": backend, "cwd": cwd or "", "boss": boss_id,
            "is_master": is_master, "model": model or "",
        })
        print(result)
        return 0 if ok else 1
    _, sess, tab = C.parse_agent_id(aid)
    if cwd is None:
        cwd = os.path.join(INSTALL_DIR, "run", "boss" if is_master else "eng")
    os.makedirs(cwd, exist_ok=True)
    pretrust(cwd)

    launch = build_launch(aid, cwd, boss_id, is_master, model, resume_session=resume_session)
    # audit spawn_cmd string (model pinned so /agents shows exact per-engineer model)
    parts = ["mp", "spawn", aid]
    if boss_id:
        parts += ["--boss", boss_id]
    if cwd:
        parts += ["--cwd", cwd]
    if is_master:
        parts += ["--master"]
    if (not is_master and model) or (is_master and model):
        parts += ["--model", model]
    spawn_cmd = " ".join(shlex.quote(x) for x in parts)

    e = tmux_env()
    if window_exists(sess, tab):
        print("mp spawn: %s already exists, reusing" % aid)
    else:
        if not session_exists(sess):
            subprocess.run(["tmux", "new-session", "-d", "-s", "mc-%s" % sess, "-n", tab,
                            "-c", cwd, launch], env=e, capture_output=True)
            subprocess.run(["tmux", "set-option", "-g", "-t", "mc-%s" % sess, "automatic-rename", "off"],
                           env=e, capture_output=True)
        else:
            subprocess.run(["tmux", "new-window", "-d", "-t", "mc-%s" % sess, "-n", tab,
                            "-c", cwd, launch], env=e, capture_output=True)
        tgt = "mc-%s:%s" % (sess, tab)
        # disable auto-rename so mc-<sess>:<tab> keeps resolving by name (§5 window naming)
        subprocess.run(["tmux", "set-option", "-t", tgt, "-w", "automatic-rename", "off"], env=e, capture_output=True)
        subprocess.run(["tmux", "set-option", "-t", tgt, "-w", "allow-rename", "off"], env=e, capture_output=True)
        subprocess.run(["tmux", "rename-window", "-t", tgt, tab], env=e, capture_output=True)
        # load the CEO tmux conf into this (possibly new) server
        conf = os.path.expanduser("~/.tmux.conf")
        if os.path.exists(conf):
            subprocess.run(["tmux", "source-file", conf], env=e, capture_output=True)

    # durable roster
    roster = load_roster()
    prior = roster.get(aid, {})
    roster[aid] = {"agent_id": aid, "host": HOST_ID, "session": sess, "tab": tab,
                   "backend": backend, "boss_id": boss_id, "cwd": cwd, "spawn_cmd": spawn_cmd,
                   "model": (model or ""), "is_master": is_master, "retired": False,
                   "session_id": resume_session or prior.get("session_id", ""),
                   "summary": prior.get("summary", "")}
    save_roster(roster)

    # initial status; master gets a keyword-bearing, locked doctrine summary (J2c)
    if is_master:
        write_status(aid, "starting", summary=DOCTRINE_SUMMARY, locked=True)
    else:
        write_status(aid, "starting")

    # register with the queue-server
    C.http_json("POST", QUEUE_URL + "/agents/register",
                {"agent_id": aid, "host": HOST_ID, "session": sess, "tab": tab,
                 "backend": backend, "state": "alive", "boss_id": boss_id,
                 "is_master": is_master,
                 "summary": (DOCTRINE_SUMMARY if is_master else ""),
                 "spawn_cmd": spawn_cmd, "model": (model or "")}, HDR, timeout=6)

    start_recorder(tab, sess)

    # SELF-CHECK window naming
    r = subprocess.run(["tmux", "list-windows", "-t", "mc-%s" % sess, "-F", "#{window_name}"],
                       env=e, capture_output=True, text=True)
    if tab not in r.stdout.split():
        print("ERROR: window %s not named correctly after spawn" % tab, file=sys.stderr)
        return 4

    if is_master and not resume_session:
        # send the onboarding prompt (doctrine internalized) after the TUI comes up
        time.sleep(6)
        doc = ""
        if os.path.exists(BOSS_DOC):
            doc = open(BOSS_DOC).read()
        prompt = ("You are the mypeople Boss (agent %s). Read your doctrine below and internalize it, "
                  "then wait for [todo] pings. Reply concisely that you are ready.\n\n%s" % (aid, doc[:6000]))
        C.tmux_send_message("mc-%s:%s" % (sess, tab), prompt)
    print("spawned %s" % aid)
    return 0


def do_send(argv):
    if len(argv) < 2:
        print("usage: mp send <agent_id> <msg>", file=sys.stderr); return 2
    aid = full_aid(argv[0])
    msg = " ".join(argv[1:])
    if not is_local(aid):
        ok, result = remote_task("send", aid, {"message": msg}, timeout=30)
        print(result)
        return 0 if ok else 1
    ok = C.tmux_send_message(C.tmux_target(aid), msg)
    print("sent" if ok else "no_pane")
    return 0 if ok else 1


def classify(pane):
    low = pane.lower()
    if "do you want" in low or "❯ 1." in pane or "1. yes" in low or "would you like" in low:
        return "BLOCKED"
    tail = "\n".join(pane.strip().splitlines()[-6:]).lower()
    if "esc to interrupt" in tail or "✳" in pane[-400:] or "running" in tail or "tokens" in tail:
        return "WORKING"
    return "IDLE"


def do_peek(argv):
    if not argv:
        print("usage: mp peek <agent_id>", file=sys.stderr); return 2
    aid = full_aid(argv[0])
    if not is_local(aid):
        ok, result = remote_task("peek", aid, {}, timeout=30)
        print(result)
        return 0 if ok else 1
    pane = C.tmux_capture(C.tmux_target(aid))
    print("[state:%s]" % classify(pane))
    print(pane)
    return 0


def do_kill(argv):
    if not argv:
        print("usage: mp kill <agent_id> [--reason ...]", file=sys.stderr); return 2
    aid = full_aid(argv[0])
    reason = ""
    if "--reason" in argv:
        idx = argv.index("--reason")
        reason = " ".join(argv[idx + 1:])
    if not is_local(aid):
        ok, result = remote_task("kill", aid, {"reason": reason}, timeout=60)
        print(result)
        return 0 if ok else 1
    _, sess, tab = C.parse_agent_id(aid)
    e = tmux_env()
    roster = load_roster()
    if aid in roster:
        roster[aid]["retired"] = True
        roster[aid]["retire_reason"] = reason or "killed"
        roster[aid]["retired_ts"] = time.time()
        save_roster(roster)
    C.http_json("POST", QUEUE_URL + "/agents/unregister", {"agent_id": aid}, HDR, timeout=6)
    subprocess.run(["tmux", "kill-window", "-t", "mc-%s:%s" % (sess, tab)], env=e, capture_output=True)
    subprocess.run(["tmux", "kill-session", "-t", "rec-%s" % tab], env=e, capture_output=True)
    print("killed %s" % aid)
    return 0


def do_answer(argv):
    if len(argv) < 2:
        print("usage: mp answer <agent_id> <N>", file=sys.stderr); return 2
    aid = full_aid(argv[0])
    n = argv[1]
    if not is_local(aid):
        ok, result = remote_task("answer", aid, {"n": n}, timeout=30)
        print(result)
        return 0 if ok else 1
    tgt = C.tmux_target(aid)
    e = tmux_env()
    subprocess.run(["tmux", "send-keys", "-t", tgt, str(n)], env=e, capture_output=True)
    time.sleep(0.2)
    subprocess.run(["tmux", "send-keys", "-t", tgt, "Enter"], env=e, capture_output=True)
    print("answered %s -> %s" % (aid, n))
    return 0


def do_revive(argv):
    if not argv:
        print("usage: mp revive <agent_id>", file=sys.stderr); return 2
    aid = full_aid(argv[0])
    if not is_local(aid):
        ok, result = remote_task("revive", aid, {}, timeout=150)
        print(result)
        return 0 if ok else 1
    roster = load_roster()
    rr = roster.get(aid)
    if not rr:
        print("unknown agent %s" % aid, file=sys.stderr); return 1
    if not rr.get("retired"):
        print("ERROR: %s is not retired" % aid, file=sys.stderr); return 1
    sid = rr.get("session_id", "")
    if not sid:
        _, sess, tab = C.parse_agent_id(aid)
        status = C.read_json(os.path.join(STATUS_DIR, "mc-%s" % sess, "%s.json" % tab), {}) or {}
        sid = status.get("session_id", "")
    transcripts = []
    if sid:
        import glob
        transcripts = glob.glob(os.path.expanduser("~/.claude/projects/**/%s.jsonl" % sid), recursive=True)
    if not sid or not transcripts:
        print("ERROR: %s is not resumable: persisted Claude session transcript is missing" % aid,
              file=sys.stderr)
        return 1
    args = [aid]
    if rr.get("boss_id"):
        args += ["--boss", rr["boss_id"]]
    if rr.get("cwd"):
        args += ["--cwd", rr["cwd"]]
    if rr.get("is_master"):
        args += ["--master"]
    if rr.get("model"):
        args += ["--model", rr["model"]]
    return do_spawn(args, resume_session=sid)


def do_ensure_boss(argv):
    """Keep the singleton Boss alive without ever replacing a resumable session.

    A genuinely new node has no roster entry and may spawn its first Boss. Once an entry exists,
    recovery is strict: mark a missing window retired and route through do_revive(), which restores
    the persisted Claude session and original structured spawn flags or surfaces an error.
    """
    aid = full_aid(argv[0] if argv else "%s/main:Boss" % HOST_ID)
    _, sess, tab = C.parse_agent_id(aid)
    if window_exists(sess, tab):
        print("Boss already alive: %s" % aid)
        return 0
    roster = load_roster()
    rr = roster.get(aid)
    if rr is None:
        return do_spawn([aid, "--master"])
    if not rr.get("is_master"):
        print("ERROR: %s exists but is not recorded as the Boss" % aid, file=sys.stderr)
        return 1
    if not rr.get("retired"):
        rr["retired"] = True
        rr["retire_reason"] = "boss-window-missing"
        rr["retired_ts"] = time.time()
        save_roster(roster)
    return do_revive([aid])


def do_status(argv):
    code, agents = C.http_json("GET", QUEUE_URL + "/agents", None, HDR, timeout=6)
    code2, clients = C.http_json("GET", QUEUE_URL + "/clients", None, HDR, timeout=6)
    print("== agents ==")
    for a in (agents or []):
        print("%-45s [%s] %s boss=%s" % (a["agent_id"], a.get("state", "?"),
                                         a.get("status", ""), a.get("boss_id", "")))
    print("== clients ==")
    for c in (clients or []):
        print("%-25s %s state=%s" % (c["hostname"], c.get("attach_base", ""), c.get("state", "")))
    return 0


def main():
    if len(sys.argv) < 2:
        print("usage: mp {status|spawn|send|peek|kill|answer|revive|ensure-boss} ...", file=sys.stderr)
        return 2
    verb = sys.argv[1]
    rest = sys.argv[2:]
    return {"status": do_status, "spawn": do_spawn, "send": do_send, "peek": do_peek,
            "kill": do_kill, "answer": do_answer, "revive": do_revive,
            "ensure-boss": do_ensure_boss}.get(
        verb, lambda a: (print("unknown verb %s" % verb, file=sys.stderr) or 2))(rest)


if __name__ == "__main__":
    sys.exit(main())
